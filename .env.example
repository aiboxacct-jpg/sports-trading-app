# Copy to .env and fill in. NEVER commit .env or paste these values into chat.
# Get credentials from your Kalshi account (Settings -> API keys).

# The API key id (a UUID).
KALSHI_API_KEY_ID=

# The RSA private key used to sign requests. Paste the full PEM, using \n for
# newlines on a single line, e.g.:
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
KALSHI_PRIVATE_KEY=

# Base URL (default is the production trade API).
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
