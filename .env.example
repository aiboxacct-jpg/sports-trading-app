# Copy to .env and fill in. NEVER commit .env or paste these values into chat.
# Full walkthrough: KALSHI_SETUP.md

# The API key id (from Kalshi: Settings -> API).
KALSHI_API_KEY_ID=

# EITHER point at the downloaded private-key file (easiest):
KALSHI_PRIVATE_KEY_PATH=

# ...OR paste the PEM inline (single line, \n for newlines):
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# Base URL. Start with the DEMO sandbox (fake money), switch to prod later.
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
# Production:
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# ---- Basic Auth (only needed when hosting on a public domain) ----
# Leave AUTH_PASS blank for local use (no password). Set it before exposing the app
# publicly — then the browser prompts for this user/password on every visit.
AUTH_USER=admin
# AUTH_PASS=choose-a-strong-password

# Port is set automatically by most hosts; override locally if 3210 is taken.
# PORT=3210

# ---- LIVE TRADING (real order execution) — OFF by default ----
# DANGER: when armed, the app can place REAL orders on Kalshi. Everything below stays
# fully disabled unless you set KALSHI_TRADING_ARMED=true. Build/test on the DEMO base
# URL above first (play money). See TRADING.md.
#
# Master switch. Absent/false => read-only (the app never places orders).
# KALSHI_TRADING_ARMED=true
#
# Safety interlock: even when armed, orders against PRODUCTION (real money) are refused
# unless you ALSO set this. Leave it unset while pointed at the demo base URL.
# KALSHI_TRADING_ALLOW_PROD=true
#
# Per-order caps (defaults shown): max contracts and max dollars of capital per order.
# KALSHI_TRADING_MAX_CONTRACTS=10
# KALSHI_TRADING_MAX_ORDER_DOLLARS=25
